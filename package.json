{
  "name": "everythingonline-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run content:build && npm test -- --run && npm run build:offline",
    "test": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "build:offline": "tsc --noEmit && vite build",
    "content:build": "node --import tsx scripts/content/build.ts && node --import tsx scripts/content/admin-config.ts",
    "cms:dev": "BIND_HOST=127.0.0.1 decap-server"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@types/three": "^0.185.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "decap-server": "3.11.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
